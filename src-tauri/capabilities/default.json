{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Weaver webview may do: call Weaver's own commands, listen to backend events, read window facts. Plugins are called from Rust and are not exposed.",
  "windows": ["welcome", "p-*"],
  "permissions": [
    "allow-app-info",
    "allow-startup-failures",
    "allow-open-log",
    "allow-open-url",
    "allow-update-status",
    "allow-update-later",
    "allow-update-install",
    "allow-settings-get",
    "allow-settings-set",
    "allow-board-snapshot",
    "allow-delete-task",
    "allow-approve-proposal",
    "allow-reject-proposal",
    "allow-discard-proposal",
    "allow-choose-proposal-model",
    "allow-resolve-drift",
    "allow-fix-drift-code",
    "allow-accept-drift-proposal",
    "allow-dismiss-drift",
    "allow-history-snapshot",
    "allow-view-snapshot",
    "allow-project-status",
    "allow-initialise-project",
    "allow-update-skills",
    "allow-project-folder",
    "allow-import-code",
    "allow-omp-status",
    "allow-omp-install",
    "allow-omp-log-in",
    "allow-omp-log-out",
    "allow-welcome-state",
    "allow-open-project",
    "allow-open-folder",
    "allow-remove-recent",
    "allow-open-in-editor",
    "allow-jobs-snapshot",
    "allow-job-conversation",
    "allow-job-send-message",
    "allow-job-stop",
    "allow-job-answer-permission",
    "allow-job-remove",
    "allow-run-task",
    "allow-run-all",
    "allow-scan-system",
    "allow-general-snapshot",
    "allow-general-send-message",
    "allow-general-stop",
    "allow-general-answer-permission",
    "allow-general-clear",
    "allow-requests-list",
    "allow-request-read",
    "allow-request-new",
    "allow-request-save",
    "allow-request-send",
    "allow-request-discard",
    "allow-request-image-add",
    "allow-request-image-import",
    "allow-request-image",
    "allow-requests-flushed",
    "allow-question-round-get",
    "allow-question-round-act",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:default"
  ]
}
